{
  "name": "slotwork",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --import tsx --watch server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "start": "node --import tsx server/index.ts --production",
    "lint": "eslint src server",
    "test": "vitest run",
    "test:server": "vitest run server/tests",
    "test:ui": "vitest run tests",
    "test:logic": "tsx tests/logic/search.check.ts && tsx tests/logic/titles.check.ts",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs && node scripts/i18n-extract.mjs --missing ru && node scripts/i18n-extract.mjs --missing uz"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.19.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "mailparser": "^3.9.38",
    "postcss": "^8.4.49",
    "smtp-server": "^3.19.21",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
