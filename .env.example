# Copy to .env and load it with:  node --env-file=.env --import tsx server/index.ts --production
PORT=3000
# SQLite file. The folder is created if missing. Back this file up (it is your whole database).
DATABASE_PATH=./data/slotwork.db
# Demo accounts (password "demo1234") and sample jobs. ON by default in development, OFF in production.
# Never enable in a public deployment.
SEED_DEMO=false
# First administrator, created once if no admin exists. Use a strong password and change it after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to true only when running behind a reverse proxy (nginx, Caddy, a load balancer) that terminates HTTPS.
TRUST_PROXY=false

# --- Email (password reset). Without SMTP: development prints emails to the server console; production disables email and the UI says so.
# Either one URL (smtp:// = STARTTLS/plain, smtps:// = TLS; percent-encode special characters in the password) ...
SMTP_URL=
# ... or separate settings:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
MAIL_FROM=Slotwork <no-reply@your-domain.example>
# Public address of the site, used inside email links. REQUIRED in production for email to work (it is never taken from the request).
APP_URL=https://your-domain.example
